    "settings.scopes.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis zu 32 Kanäle erscheinen in einem mehrzeiligen Raster. Der Wert begrenzt umfangreiche IT-Module."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up to 32 channels appear in a multi-row grid. This value limits large IT modules."
