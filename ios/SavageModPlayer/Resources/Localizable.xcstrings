    "settings.sound.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PAL ist die europäische Amiga-Taktrate und bestimmt die Tonhöhe von MOD-Dateien. Der LED-Filter ist der Tiefpass des Amiga 500. Ohne Interpolation klingen die Samples rauer und originalgetreuer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PAL is the European Amiga clock rate and sets the pitch of MOD files. The LED filter is the low-pass of the Amiga 500. Without interpolation the samples sound rougher and closer to the original."
          }
        }
      }
    },
