    "import.intro": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Ordner. Alles Spielbare darin wird mitsamt Unterordnern in die Bibliothek kopiert, ZIP-Archive werden ausgepackt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a folder. Everything playable inside is copied into the library including subfolders; ZIP archives are unpacked."
          }
        }
      }
    },
