      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur ausdrücklich gewählte Werte überschreiben die globalen Vorgaben. Andere Titel behalten ihre eigenen Einstellungen."
