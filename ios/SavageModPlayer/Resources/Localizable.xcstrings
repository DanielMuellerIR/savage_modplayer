      }
    },
    "A/B beginnt mit dem rekonstruierten Zustand bei A und schließt alle Ticks von B ein. Ausschalten spielt an der aktuellen Stelle weiter. Sprünge oder Audioeinstellungen lösen die Schleife.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "A/B beginnt mit dem rekonstruierten Zustand bei A und schließt alle Ticks von B ein. Ausschalten spielt an der aktuellen Stelle weiter. Sprünge oder Audioeinstellungen lösen die Schleife."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A/B restores the playback state at A and includes every tick of B. Turning it off continues from the current point. Seeking or changing audio settings clears the loop."
          }
        }
      }
    },
