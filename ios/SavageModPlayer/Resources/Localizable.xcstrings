    },
    "Songpositionen beginnen bei 1, Zeilen bei 0. Ein Sprung erhält Play/Pause/Stopp; Tempo wird wie beim Tracker-Zeilenklick rekonstruiert. Laufende Stimmen und Effekte sind dabei näherungsweise.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Songpositionen beginnen bei 1, Zeilen bei 0. Ein Sprung erhält Play/Pause/Stopp; Tempo wird wie beim Tracker-Zeilenklick rekonstruiert. Laufende Stimmen und Effekte sind dabei näherungsweise."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Song positions start at 1, rows at 0. A jump preserves playing, paused or stopped state; tempo is reconstructed as for a tracker row click. Existing voices and effects are approximate."
          }
        }
      }
    },
    "Songstellen konnten nicht geladen werden. Speichern ist gesperrt; die Datei bleibt erhalten.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Songstellen konnten nicht geladen werden. Speichern ist gesperrt; die Datei bleibt erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Song markers could not be loaded. Saving is disabled; the file is preserved."
          }
        }
      }
    },
    "Songstellen konnten nicht gespeichert werden. Der bisherige Stand bleibt erhalten.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
