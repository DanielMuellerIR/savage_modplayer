    "settings.visualizers.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oszilloskope starten automatisch beim Hineinscrollen und geben Views wie Wellenform-Caches beim Herausscrollen wieder frei. Am Klang ändert das nichts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Oscilloscopes start automatically when scrolled into view and release their views and waveform caches when scrolled away. The sound stays exactly the same."
          }
        }
      }
