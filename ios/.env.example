# Vorlage fuer ios/.env — diese Datei hier ist eingecheckt, ios/.env NICHT.
#
# So wird sie benutzt:
#   cp ios/.env.example ios/.env
#   # danach in ios/.env die eigene Team-ID eintragen
#
# Die Team-ID ist die zehnstellige Kennung des eigenen Apple-Developer-Teams.
# Sie steht im Developer-Portal unter "Membership details" und in Xcode unter
# Settings -> Accounts. Sie gehoert nicht ins Repo: das Repo ist
# veroeffentlichbar, die Team-ID ist eine Konto-Kennung.
#
# Nur der Geraete-Build (ios/scripts/build-device.sh) braucht sie. Simulator-Build
# und Simulator-Tests laufen ohne Signatur und damit ohne Team-ID.

SAVAGE_DEVELOPMENT_TEAM=XXXXXXXXXX
