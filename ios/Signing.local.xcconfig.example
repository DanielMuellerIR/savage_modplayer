// Vorlage. Kopieren nach ios/Signing.local.xcconfig — DIESE Datei hier ist
// eingecheckt, die Kopie ist gitignoriert.
//
//     cp ios/Signing.local.xcconfig.example ios/Signing.local.xcconfig
//
// Die Team-ID ist die zehnstellige Kennung des eigenen Apple-Developer-Teams.
// Sie steht im Developer-Portal unter "Membership details" und in Xcode unter
// Settings -> Accounts.
//
// Nur der Geraete-Build braucht sie. Simulator-Build und Simulator-Tests laufen
// ohne Signatur und damit ohne Team-ID.

DEVELOPMENT_TEAM = XXXXXXXXXX
